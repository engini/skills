{
  "_comment": "The one source of truth for what the Flo hook refuses or asks about. tools/generate.py emits the hook's constant block, the SKILL.md never-verb block and the README blocks from this file. Edit here, run python3 tools/generate.py, commit the outputs. never_verbs = never on Flo's own initiative: the hook and the settings ASK the user every time (Codex: prompt). raw_key_* = Flo never runs them: the hook DENIES with instructions, the settings ASK, Codex prompts with a justification to decline and run it in the user's own terminal (no hook there).",
  "deny_token": "FLO-HOOK-DENY",
  "ask_token": "FLO-HOOK-ASK",
  "never_verbs": [
    "engini_workflows_delete_workflow",
    "engini_workflows_run_workflow",
    "engini_workflows_enable_or_disable_workflow",
    "engini_workflows_rerun_execution"
  ],
  "write_verbs_ask": [
    "engini_workflows_create_workflow_from_plan",
    "engini_workflows_update_workflow_from_plan"
  ],
  "call_value_flags": ["--args", "--file", "--connection", "--toolset", "--llm", "--tool-call-id", "--max-bytes"],
  "raw_key_commands": [
    ["connect"],
    ["login"],
    ["connections", "create"],
    ["connections", "update"],
    ["connections", "delete"],
    ["connections", "auth-providers", "create"],
    ["connections", "auth-providers", "update"]
  ],
  "raw_key_flags": ["--api-key"],
  "key_env_vars": ["ENGINI_API_KEY", "ENGINI_API_TOKEN", "ENGINI_COMPANY_TOKEN"],
  "key_path_patterns": [
    "(?:\\.config|XDG_CONFIG_HOME\\}?|APPDATA%?|AppData[\\\\/]+Roaming)[\\\\/]+engini\\b",
    "[\\\\/]engini[\\\\/]+config\\.toml"
  ],
  "key_path_display": [
    "~/.config/engini/config.toml (macOS, Linux)",
    "$XDG_CONFIG_HOME/engini/config.toml (when XDG_CONFIG_HOME is set)",
    "%APPDATA%\\engini\\config.toml (Windows)",
    "%USERPROFILE%\\engini\\config.toml (Windows, when APPDATA is unset)"
  ],
  "self_protect_patterns": [
    "deny-never-verbs",
    "hooks[\\\\/][A-Za-z0-9_-]*hooks\\.json",
    "(?<![A-Za-z0-9_-])\\.claude[\\\\/]+plugins",
    "(?<![A-Za-z0-9_-])\\.codex[\\\\/]",
    "(?<![A-Za-z0-9_-])\\.codex[\\\\/]*(?=[\\s;&|)'\"]|\\Z)",
    "(?<![A-Za-z0-9_-])\\.claude[\\\\/]+[^\\s\\\\/]*[*?\\[{$`]",
    "(?<![A-Za-z0-9_-])\\.(?:claude|codex)[\\\\/](?:[^\\s\\\\/;&|<>]*[\\\\/])*\\.\\.?(?=[\\\\/\\s;&|)'\"<>`]|\\Z)",
    "\\A(?!(?![\\s\\S]*?(?:settings|plugins|disableAllHooks|enabledPlugins|\\.\\.|--pre\\b|--ou|--hostname-bin|[A-Za-z0-9]~[0-9]))(?:[ \\t]*(?:ls|du|stat|file|wc|cat|head|tail|grep|rg|mkdir|pwd|echo|test|dir|gci|Get-ChildItem|git[ \\t]+(?:add|status|diff|log|show|ls-files|blame|commit))(?:[ \\t]+[^\\s;&|<>$`(){}*?\\[\\]\\\\#]+)*[ \\t]*|[ \\t]*cd(?:[ \\t]+[^\\s;&|<>$`(){}*?\\[\\]\\\\#]+)?[ \\t]*)(?:(?:&&|\\|\\||[;|\\n])(?:[ \\t]*(?:ls|du|stat|file|wc|cat|head|tail|grep|rg|mkdir|pwd|echo|test|dir|gci|Get-ChildItem|git[ \\t]+(?:add|status|diff|log|show|ls-files|blame|commit))(?:[ \\t]+[^\\s;&|<>$`(){}*?\\[\\]\\\\#]+)*[ \\t]*|[ \\t]*cd(?:[ \\t]+[^\\s;&|<>$`(){}*?\\[\\]\\\\#]+)?[ \\t]*))*\\Z)(?=[\\s\\S]*?(?:(?<![A-Za-z0-9_-])\\.claude[\\\\/]*(?=[\\s;&|)\\'\"]|\\Z)|(?<![A-Za-z0-9_-])(?:cd|pushd|chdir|Set-Location|Push-Location|sl)[ \\t(]+[^;&|\\n]*\\.claude[\\\\/]))"
  ],
  "settings_path_pattern": "(?<![A-Za-z0-9_-])\\.claude[\\\\/]+settings",
  "claude_folder_read": "\\A(?![\\s\\S]*?(?:settings|plugins|disableAllHooks|enabledPlugins|\\.\\.|--pre\\b|--ou|--hostname-bin|[A-Za-z0-9]~[0-9]))(?:[ \\t]*(?:ls|du|stat|file|wc|cat|head|tail|grep|rg|mkdir|pwd|echo|test|dir|gci|Get-ChildItem|git[ \\t]+(?:add|status|diff|log|show|ls-files|blame|commit))(?:[ \\t]+[^\\s;&|<>$`(){}*?\\[\\]\\\\#]+)*[ \\t]*|[ \\t]*cd(?:[ \\t]+[^\\s;&|<>$`(){}*?\\[\\]\\\\#]+)?[ \\t]*)(?:(?:&&|\\|\\||[;|\\n])(?:[ \\t]*(?:ls|du|stat|file|wc|cat|head|tail|grep|rg|mkdir|pwd|echo|test|dir|gci|Get-ChildItem|git[ \\t]+(?:add|status|diff|log|show|ls-files|blame|commit))(?:[ \\t]+[^\\s;&|<>$`(){}*?\\[\\]\\\\#]+)*[ \\t]*|[ \\t]*cd(?:[ \\t]+[^\\s;&|<>$`(){}*?\\[\\]\\\\#]+)?[ \\t]*))*\\Z",
  "settings_shell_read": "\\A[ \\t]*(?:cat|grep|jq|git[ \\t]+(?:add|diff|log))(?:[ \\t]+(?:~/)?(?:[A-Za-z0-9_@+,.:/=-]|'[^'\\n]*')+)*[ \\t]*(?:(?:&&|\\|\\||[;|\\n])[ \\t]*(?:cat|grep|jq|git[ \\t]+(?:add|diff|log))(?:[ \\t]+(?:~/)?(?:[A-Za-z0-9_@+,.:/=-]|'[^'\\n]*')+)*[ \\t]*)*\\Z",
  "settings_refuse_keys": [
    "disableAllHooks",
    "enabledPlugins",
    "extraKnownMarketplaces"
  ],
  "settings_refuse_env": "\\A(?:PATH|PYTHON\\w*|HOME|USERPROFILE|CLAUDE_CONFIG_DIR|BASH_ENV|ENV|ZDOTDIR|SHELL|NODE_OPTIONS|CLAUDE_CODE_\\w+|LD_\\w+|DYLD_\\w+)\\Z",
  "settings_command_keys": [
    "hooks",
    "statusLine",
    "apiKeyHelper",
    "awsAuthRefresh",
    "gcpAuthRefresh",
    "proxyAuthHelper",
    "awsCredentialExport",
    "otelHeadersHelper",
    "fileSuggestion",
    "enableAllProjectMcpServers",
    "enabledMcpjsonServers"
  ],
  "settings_ask_modes": [
    "default",
    "acceptEdits",
    "plan",
    "auto"
  ]
}
