{
  "description": "Flo guard: refuses the four never-verb engini tool calls, raw-key engini commands, reads of the engini CLI key, and edits to this hook or agent settings.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/deny-never-verbs.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/deny-never-verbs.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
